HOMEFY_STATE_DIR=/var/lib/homefy
HOMEFY_LOG_DIR=/var/log/homefy
HOMEFY_ASSET_DIR=/var/lib/homefy/assets
ECOM_ENV_FILE=/etc/homefy/integrations.env
HOMEFY_PUBLIC_ORIGIN=https://app.homefyshop.online
HOMEFY_COOKIE_SECURE=1
HOMEFY_SESSION_TTL=43200
HOMEFY_HERMES_PROVIDER=openai-api
HOMEFY_HERMES_MODEL=gpt-5-mini
HOMEFY_HERMES_REASONING=low
HOMEFY_HERMES_TIMEOUT_MIN=20
HOMEFY_MAX_DAILY_RUNS=30
