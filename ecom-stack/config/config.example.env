# ecom-stack — variáveis de ambiente (EXEMPLO — nunca commitar o .env real)
# Copiar para config/.env e preencher com as tuas credenciais.
# Documentação: docs/integracoes-cli.md e docs/setup-vps.md
#
# NOTA: este ficheiro continha anteriormente o prompt chain "Loja completa",
# que vive (corretamente) em prompts/loja-completa.md. O conteúdo original
# está preservado nesse ficheiro e no histórico do Git.

# ── Shopify (obrigatório para a Fase 2 — ver docs/setup-vps.md §2.1/2.1b) ────
# App criado no Shopify Dev Dashboard.
SHOPIFY_STORE_DOMAIN=          # ex. minha-loja.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=       # token do app Custom Admin API (read_themes mínimo)
SHOPIFY_API_VERSION=2025-07    # versão da Admin API

# ── Meta Marketing API (Fase 5 — publicar e testar) ─────────────────────────
# https://developers.facebook.com → app + System User
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=            # formato: act_123456789
META_PIXEL_ID=
META_PAGE_ID=

# ── TikTok Marketing API (Fase 5) ───────────────────────────────────────────
# https://developers.tiktok.com → app + advertiser
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_ID=

# ── Geração de criativos (Fase 4) ───────────────────────────────────────────
# https://developers.picsart.io — editar imagens, staging, etc.
# Alternativa: os geradores de imagem/vídeo do ambiente Kimi não precisam de chave.
PICSART_API_KEY=
